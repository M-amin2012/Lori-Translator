}
function runTranslation(override) {
  const input=typeof override==='string'?override:$('sourceText').value;
  if(!input.trim()) {lastTranslation='';lastSwapText='';showResult('لطفاً ابتدا یک واژه یا عبارت وارد کن.',true,'ورودی خالی است','—');renderSuggestions([]);return;}
