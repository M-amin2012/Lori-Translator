function tokenize(text) { return String(text).match(/[\p{L}\p{M}]+|[^\p{L}\p{M}]+/gu)||[]; }
function isWordSeparator(value) { return /^\s+$/u.test(value) || /^[‌‎‏]+$/u.test(value); }

function buildSourceIndex(dir) {
  const map = new Map();
  function addVariant(from, outputs, row) {
    const key = normalize(from); if(!key) return;
    if(!map.has(key)) map.set(key,{from,parts:key.split(' '),variants:[]});
    const entry = map.get(key);
    const variant = {from,outputs:[...outputs],category:row.category,source:row.source||'',meaning:dir==='fa-lo'?(row.meaning||''):''};
    const signature = JSON.stringify([variant.from,variant.outputs,variant.category,variant.meaning]);
    if(!entry.variants.some(v=>JSON.stringify([v.from,v.outputs,v.category,v.meaning])===signature)) entry.variants.push(variant);
  }
  for(const row of DICTIONARY) {
    if(dir==='fa-lo') {
      const primary = row.fa_input || row.fa;
      addVariant(primary,row.lo,row);
      for(const alias of row.fa_aliases||[]) addVariant(alias,row.lo,row);
    } else {
      for(const lori of row.lo) addVariant(lori,[row.fa],row);
    }
  }
  return [...map.values()].sort((a,b)=>b.parts.length-a.parts.length || b.from.length-a.from.length);
}
function sourceIndex(dir=direction) {
  if(!indexCache[dir]) indexCache[dir]=buildSourceIndex(dir);
  return indexCache[dir];
}
function resolveOutput(entry, matchedText, dir=direction) {
  let variants=entry.variants;
  const exactKey=normalizeExact(matchedText);
  const exact=variants.filter(v=>normalizeExact(v.from)===exactKey);
  if(exact.length) {
    const confirmedExact=exact.filter(v=>v.source==='تأیید مستقیم کاربر');
    variants=confirmedExact.length?confirmedExact:exact;
  } else {
    const confirmed=variants.filter(v=>v.source==='تأیید مستقیم کاربر');
    if(confirmed.length) variants=confirmed;
  }
  const plain=[];
  const display=[];
  for(const variant of variants) {
    for(const out of variant.outputs) {
      plain.push(out);
      display.push(dir==='fa-lo' && variant.meaning ? `${out} (${variant.meaning})` : out);
    }
  }
  const cleanKey=value=>normalize(value).replace(/[.,،؛:!?؟]/g,'').replace(/\s+/g,' ').trim();
  const dedupe=values=>{const seen=new Set(),out=[];for(const value of values){const key=cleanKey(value);if(!seen.has(key)){seen.add(key);out.push(value);}}return out;};
  const uniquePlain=dedupe(plain);
  const uniqueDisplay=dedupe(display);
  const categories=[...new Set(variants.map(v=>v.category).filter(Boolean))];
  const ambiguous=variants.some(v=>Boolean(v.meaning));
  const plainSeparator=dir==='fa-lo'?'، ':' / ';
  const displaySeparator=dir==='fa-lo'?(ambiguous?' / ':'، '):' / ';
  return {plain:uniquePlain.join(plainSeparator),text:uniqueDisplay.join(displaySeparator),categories};
}
function translate(input) {
  const entries=sourceIndex();
  const tokens=tokenize(input);
  const out=[],plainOut=[],found=[],unknown=[];
  let i=0;
  while(i<tokens.length) {
    if(!/[\p{L}\p{M}]/u.test(tokens[i])) { out.push(tokens[i]); plainOut.push(tokens[i]); i++; continue; }
    let match=null,consumed=0;
    for(const entry of entries) {
      const n=entry.parts.length; let ok=true,ti=i;
      for(let p=0;p<n;p++) {
        if(ti>=tokens.length || !/[\p{L}\p{M}]/u.test(tokens[ti]) || normalize(tokens[ti])!==entry.parts[p]) {ok=false;break;}
        if(p<n-1) {
          const sep=tokens[ti+1]||'';
          if(!isWordSeparator(sep)) {ok=false;break;}
          ti+=2;
        }
      }
      if(ok) {match=entry;consumed=n===1?1:n*2-1;break;}
    }
    if(match) {
      const matchedText=tokens.slice(i,i+consumed).join('');
      const resolved=resolveOutput(match,matchedText);
      out.push(resolved.text); plainOut.push(resolved.plain);
      found.push({...match,category:resolved.categories});
      i+=consumed;
    } else {
      const raw=tokens[i];
      if(!unknown.some(x=>normalize(x)===normalize(raw))) unknown.push(raw);
      out.push(raw); plainOut.push(raw); i++;
    }
  }
