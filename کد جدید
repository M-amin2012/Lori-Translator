  try {
    const parsed=JSON.parse(safeStorageGet('lorvazhe_history_v2','[]'));
    return Array.isArray(parsed)?parsed.filter(x=>x&&typeof x.source==='string'&&typeof x.result==='string').slice(0,40):[];
  } catch {return[];}
}
function persistHistory() {safeStorageSet('lorvazhe_history_v2',JSON.stringify(historyItems.slice(0,40)));}
function saveHistory(source,result,plainResult) {
  if(!result||normalize(source)===normalize(result))return;
  const latest=historyItems[0];
  if(latest&&latest.direction===direction&&normalize(latest.source)===normalize(source)&&normalize(latest.result)===normalize(result))return;
  historyItems.unshift({source,result,plainResult,direction,date:new Date().toLocaleString('fa-IR')});
  historyItems=historyItems.slice(0,40);persistHistory();
}
function renderHistory() {
  const q=normalize($('historySearch').value),list=$('historyList');
  const found=historyItems.map((x,i)=>({...x,index:i})).filter(x=>!q||normalize(x.source+' '+x.result).includes(q));
  if(!found.length) {list.innerHTML=`<div class="empty-history">${historyItems.length?'موردی مطابق جست‌وجو پیدا نشد.':'هنوز ترجمه‌ای ثبت نشده است.'}</div>`;return;}
  list.innerHTML=found.slice(0,20).map(item=>`<div class="history-item"><div><p>${escapeHTML(item.source)} <span class="muted">←</span> ${escapeHTML(item.result)}</p><p class="muted">${escapeHTML(item.date||'')}</p></div><button type="button" data-history="${item.index}">نمایش</button></div>`).join('');
}
function categories() {
  const counts=new Map();for(const item of DICTIONARY)counts.set(item.category,(counts.get(item.category)||0)+1);
  return [...counts.entries()].sort((a,b)=>{const ai=CATEGORY_ORDER.indexOf(a[0]),bi=CATEGORY_ORDER.indexOf(b[0]);if(ai<0&&bi<0)return a[0].localeCompare(b[0],'fa');if(ai<0)return 1;if(bi<0)return -1;return ai-bi;});
}
function renderCategories() {
  const list=$('categoryList'),cats=categories();
  list.innerHTML=[`<button type="button" class="category-chip ${activeCategory==='همه'?'active':''}" data-category="همه">همه <small>${faNumber(DICTIONARY.length)}</small></button>`,...cats.map(([cat,count])=>`<button type="button" class="category-chip ${activeCategory===cat?'active':''}" data-category="${escapeHTML(cat)}">${CATEGORY_ICONS[cat]||'🔤'} ${escapeHTML(cat)} <small>${faNumber(count)}</small></button>`)].join('');
}
function entrySearchText(row) {
  return normalize([row.fa,row.fa_input,row.meaning,...(row.fa_aliases||[]),...(row.lo||[]),row.category,row.kind].filter(Boolean).join(' '));
}
function entrySearchForms(row) {
  return [row.fa_input,row.fa,...(row.fa_aliases||[]),...(row.lo||[])].filter(Boolean).map(normalize).filter(Boolean);
}
function searchTokenize(value) {
  return normalize(value).split(/[^\p{L}\p{N}]+/u).filter(Boolean);
}
function fuzzyTokenDistance(queryToken, candidateToken) {
  if(!queryToken || !candidateToken) return Infinity;
  const maxLen=Math.max(queryToken.length,candidateToken.length);
  const allowed=queryToken.length<=4?1:queryToken.length<=8?2:3;
  if(Math.abs(queryToken.length-candidateToken.length)>allowed) return Infinity;
  const distance=damerauLevenshtein(queryToken,candidateToken);
  return distance<=allowed && distance/maxLen<=.34 ? distance : Infinity;
}
function entrySearchScore(row,q) {
  const forms=entrySearchForms(row);
  if(forms.includes(q))return 0;                          // تطبیق کامل
  if(forms.some(x=>x.startsWith(q)))return 1;             // ابتدای واژه یا عبارت
  if(forms.some(x=>x.includes(q)))return 2;               // بخشی از واژه یا عبارت

  const queryTokens=searchTokenize(q);
  if(!queryTokens.length)return Infinity;
  const allTokens=[...new Set(forms.flatMap(searchTokenize))];
  if(queryTokens.every(t=>allTokens.some(x=>x.startsWith(t))))return 3; // ابتدای چند واژه
  if(queryTokens.every(t=>allTokens.some(x=>x.includes(t))))return 4;  // جست‌وجوی چندبخشی بدون وابستگی به ترتیب

  // حدس املایی فقط پس از شکست تطبیق‌های مستقیم؛ برای ورودی‌های کوتاه بسیار محافظه‌کار است.
  if(queryTokens.some(t=>t.length<3))return Infinity;
  let total=0;
  for(const token of queryTokens) {
    let best=Infinity;
    for(const candidate of allTokens) best=Math.min(best,fuzzyTokenDistance(token,candidate));
    if(!Number.isFinite(best))return Infinity;
    total+=best/Math.max(1,token.length);
  }
  return 10+(total/queryTokens.length);
}
function renderDictionary() {
  const q=normalize($('dictionarySearch').value);
  let rows=DICTIONARY.map((x,index)=>({...x,index,searchScore:0}));
  if(activeCategory!=='همه')rows=rows.filter(x=>x.category===activeCategory);
  if(q){
    rows=rows.map(row=>({...row,searchScore:entrySearchScore(row,q)})).filter(x=>Number.isFinite(x.searchScore));
    rows.sort((a,b)=>a.searchScore-b.searchScore||a.index-b.index);
  }
  const fuzzyOnly=Boolean(q&&rows.length&&rows[0].searchScore>=10);
  $('wordMeta').textContent=`${faNumber(rows.length)} مدخل${activeCategory!=='همه'?' در دستهٔ '+activeCategory:''}${q?(fuzzyOnly?'؛ نزدیک‌ترین پیشنهادها':'؛ نتیجهٔ جست‌وجو'):''}`;
  const grid=$('wordGrid');
  if(!rows.length){grid.innerHTML='<div class="empty-list">واژه‌ای پیدا نشد. املای دیگری را امتحان کن یا اعراب را حذف کن.</div>';return;}
  const shown=rows.slice(0,visibleLimit);
  grid.innerHTML=shown.map(x=>{
    const shownFa=x.fa_input||x.fa;
    const meaning=x.meaning && normalize(x.meaning)!==normalize(shownFa)?`<span class="word-meaning">${escapeHTML(x.meaning)}</span>`:'';
    return `<button class="word-card" type="button" data-entry="${x.index}"><span class="fa-word"><span>${escapeHTML(shownFa)}</span><span class="kind-pill">${escapeHTML(x.kind||'واژه')}</span></span>${meaning}<span class="lo-word">${escapeHTML(x.lo.join('، '))}</span><span class="word-category">${CATEGORY_ICONS[x.category]||'🔤'} ${escapeHTML(x.category)}</span></button>`;
  }).join('');
  if(rows.length>shown.length)grid.insertAdjacentHTML('beforeend',`<div class="more-wrap"><button type="button" class="more-button" data-more>نمایش واژه‌های بیشتر (${''}${faNumber(rows.length-shown.length)} باقی‌مانده)</button></div>`);
}
async function copyResult() {
  if(!lastTranslation)return;
  try {
    if(navigator.clipboard&&navigator.clipboard.writeText)await navigator.clipboard.writeText(lastTranslation);
    else throw new Error('clipboard unavailable');
    $('resultStatus').textContent='نتیجه کپی شد ✓';
  } catch {
    const temp=document.createElement('textarea');temp.value=lastTranslation;temp.style.position='fixed';temp.style.opacity='0';document.body.appendChild(temp);temp.select();
    let ok=false;try{ok=document.execCommand('copy');}catch{ok=false;}temp.remove();
    $('resultStatus').textContent=ok?'نتیجه کپی شد ✓':'کپی خودکار پشتیبانی نشد؛ متن را انتخاب کن.';
  }
}
function setTheme(theme,save=true) {
  const dark=theme==='dark';
  document.documentElement.dataset.theme=dark?'dark':'light';
  const themeSymbol=$('themeSymbol');
  themeSymbol.src=dark?'data:image/png;base64,':'data:image/png;base64,';
  themeSymbol.alt=dark?'آیکون خورشید':'آیکون ماه';
  $('themeLabel').textContent=dark?'حالت روز':'حالت شب';
  $('themeToggle').setAttribute('aria-label',dark?'فعال کردن حالت روز':'فعال کردن حالت شب');
  $('themeToggle').setAttribute('aria-pressed',String(dark));
  $('themeColorMeta').setAttribute('content',dark?'#101915':'#f4f8f5');
  if(save)safeStorageSet('lorvazhe_theme_v3',dark?'dark':'light');
}

async function animateThemeToggle(){
  const root=document.documentElement;
  const button=$('themeToggle');
  if(button.disabled)return;
  const target=root.dataset.theme==='dark'?'light':'dark';
  const reduceMotion=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(reduceMotion){setTheme(target);return;}

  const rect=button.getBoundingClientRect();
  root.style.setProperty('--theme-origin-x',`${rect.left+rect.width/2}px`);
  root.style.setProperty('--theme-origin-y',`${rect.top+rect.height/2}px`);
  button.classList.add('theme-changing');
  button.disabled=true;

  const cleanup=()=>{
    button.classList.remove('theme-changing');
    button.disabled=false;
    root.classList.remove('theme-fallback');
    root.style.removeProperty('--theme-origin-x');
    root.style.removeProperty('--theme-origin-y');
  };

  if(typeof document.startViewTransition==='function'){
    try{
      const transition=document.startViewTransition(()=>setTheme(target));
      await transition.finished;
    }catch(error){
      console.warn('View Transition was interrupted; applying theme directly.',error);
      setTheme(target);
    }finally{cleanup();}
  }else{
    root.classList.add('theme-fallback');
    setTheme(target);
    window.clearTimeout(window.__lorvazheThemeTimer);
    window.__lorvazheThemeTimer=window.setTimeout(cleanup,1900);
  }
}
$('themeToggle').addEventListener('click',animateThemeToggle);
$('translateBtn').addEventListener('click',()=>runTranslation());
$('sourceText').addEventListener('input',updateCharCount);
$('sourceText').addEventListener('keydown',e=>{if((e.ctrlKey||e.metaKey)&&e.key==='Enter')runTranslation();});
$('swapBtn').addEventListener('click',()=>{
  const previous=lastSwapText;direction=direction==='fa-lo'?'lo-fa':'fa-lo';updateDirection(false);
  if(previous){$('sourceText').value=previous;updateCharCount();runTranslation(previous);}
  else showResult('جهت ترجمه تغییر کرد.',true,'آمادهٔ ترجمه','—');
});
$('clearBtn').addEventListener('click',()=>{
  $('sourceText').value='';updateCharCount();lastTranslation='';lastSwapText='';
  showResult('ترجمهٔ شما اینجا نمایش داده می‌شود.',true,'متن پاک شد','—');renderSuggestions([]);$('sourceText').focus();
});
$('copyBtn').addEventListener('click',copyResult);
$('clearHistoryBtn').addEventListener('click',()=>{historyItems=[];persistHistory();renderHistory();});
$('historySearch').addEventListener('input',renderHistory);
$('dictionarySearch').addEventListener('input',()=>{visibleLimit=36;renderDictionary();});
$('categoryList').addEventListener('click',e=>{
  const btn=e.target.closest('[data-category]');if(!btn)return;activeCategory=btn.dataset.category;visibleLimit=36;renderCategories();renderDictionary();
});
$('wordGrid').addEventListener('click',e=>{
  const more=e.target.closest('[data-more]');if(more){visibleLimit+=36;renderDictionary();return;}
  const card=e.target.closest('[data-entry]');if(!card)return;
  const item=DICTIONARY[Number(card.dataset.entry)];if(!item)return;
  const input=direction==='fa-lo'?(item.fa_input||item.fa_aliases?.[0]||item.fa):item.lo[0];
  $('sourceText').value=input;updateCharCount();runTranslation(input);$('sourceText').focus();
});
$('suggestionList').addEventListener('click',e=>{
  const btn=e.target.closest('[data-suggest]');if(!btn)return;
  const item=currentSuggestions[Number(btn.dataset.suggest)];if(!item)return;
  $('sourceText').value=item.label;updateCharCount();runTranslation(item.label);$('sourceText').focus();
});
$('historyList').addEventListener('click',e=>{
  const btn=e.target.closest('[data-history]');if(!btn)return;
  const item=historyItems[Number(btn.dataset.history)];if(!item)return;
  direction=item.direction==='lo-fa'?'lo-fa':'fa-lo';updateDirection(false);
  $('sourceText').value=item.source;updateCharCount();lastTranslation=item.result;lastSwapText=item.plainResult||item.result;
  showResult(item.result,false,'بازیابی از سابقه','ذخیره‌شده');renderSuggestions([]);$('sourceText').focus();
});

try {
  loadDictionary();
  setTheme(safeStorageGet('lorvazhe_theme_v3','light'),false);
  renderCategories();renderDictionary();updateDirection();updateCharCount();renderHistory();
} catch(error) {
  console.error('Lorvazheh initialization error:',error);
  $('wordGrid').innerHTML='<div class="empty-list">بارگذاری واژه‌نامه با خطا روبه‌رو شد. فایل را دوباره دریافت کن.</div>';
  showResult('واژه‌نامه بارگذاری نشد.',true,'خطا در راه‌اندازی','—');
}
</script>
