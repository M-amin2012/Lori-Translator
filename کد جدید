function normalize(value) {
  // نرمال‌سازی جست‌وجو: اعراب و نشانه‌های ترکیبی فقط در کلید جست‌وجو حذف می‌شوند؛
  // متن اصلی واژه‌نامه و نتیجهٔ ترجمه بدون تغییر باقی می‌ماند.
  return String(value ?? '').normalize('NFC')
    .replace(/[يى]/g,'ی').replace(/[ك]/g,'ک').replace(/[ۀة]/g,'ه')
    .replace(/[أإٱ]/g,'ا')
    .replace(/\p{M}+/gu,'')
    .replace(/[‌‎‏ـ]/g,' ')
