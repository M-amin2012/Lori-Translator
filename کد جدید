    .replace(/[،؛:!?؟.,()\[\]{}]+/g,' ')
    .replace(/\s+/g,' ').trim().toLocaleLowerCase('fa');
}
function normalizeExact(value) {
  return String(value ?? '').normalize('NFC')
    .replace(/[ي]/g,'ی').replace(/[ك]/g,'ک').replace(/[ۀة]/g,'ه')
    .replace(/[‌‎‏ـ]/g,' ')
    .replace(/\s+/g,' ').trim().toLocaleLowerCase('fa');
}
function validateDictionary(raw) {
  if(!Array.isArray(raw)) throw new Error('ساختار واژه‌نامه معتبر نیست.');
  const seen = new Set(), output = [];
  for(const row of raw) {
    if(!row || typeof row.fa !== 'string' || !Array.isArray(row.lo)) continue;
    const lo = [...new Set(row.lo.filter(x=>typeof x==='string' && x.trim()).map(x=>x.trim()))];
    if(!lo.length) continue;
    const signature = normalize(row.fa)+'|'+lo.map(normalize).sort().join('|');
    if(seen.has(signature)) continue;
    seen.add(signature);
    output.push({...row,lo,category:row.category||'واژه‌های عمومی',kind:row.kind||'واژه',fa_aliases:Array.isArray(row.fa_aliases)?row.fa_aliases.filter(x=>typeof x==='string'&&x.trim()):[]});
  }
