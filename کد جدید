<!doctype html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#f4f8f5" id="themeColorMeta">
<meta name="description" content="مترجم و واژه‌نامهٔ فارسی و زبان لری رایج در رومشکان">
<title>لُرواژه | مترجم فارسی و لری</title>
<script>try{if(localStorage.getItem('lorvazhe_theme_v3')==='dark')document.documentElement.dataset.theme='dark';}catch(e){}</script>
<style>
:root{
  color-scheme:light;
  --bg:#f4f8f5;--paper:#ffffff;--paper-soft:#f8fbf9;--paper-tint:#eef6f0;
  --line:#dfe9e2;--line-strong:#cbdacf;--text:#19372a;--muted:#718277;
  --green:#147653;--green-deep:#0c5a3d;--green-soft:#e5f4eb;--green-border:#cfe8d7;
  --gold:#94651d;--gold-soft:#fff8e9;--gold-border:#f0dfbb;
  --blue:#3974a6;--danger:#b44d4d;--shadow:0 16px 42px rgba(31,72,48,.075);
  --field:#fcfefc;--result:#f1faf4;--result-line:#d6eadc;
  font-family:Tahoma,"Segoe UI",sans-serif;
}
:root[data-theme="dark"]{
  color-scheme:dark;
  --bg:#101915;--paper:#18251e;--paper-soft:#1d2c24;--paper-tint:#22352a;
  --line:#2a4034;--line-strong:#3a5545;--text:#e8f2eb;--muted:#a0b2a6;
  --green:#79d5a2;--green-deep:#a2e8bb;--green-soft:#203b2d;--green-border:#345b43;
  --gold:#f0c97e;--gold-soft:#3b3020;--gold-border:#66502d;
  --blue:#8cbcf0;--danger:#f09a9a;--shadow:0 18px 48px rgba(0,0,0,.22);
  --field:#132019;--result:#1c3024;--result-line:#355744;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;min-height:100vh;color:var(--text);background:radial-gradient(ellipse at 8% 0%,rgba(198,232,208,.35),transparent 35%),radial-gradient(ellipse at 94% 15%,rgba(249,226,185,.2),transparent 27%),var(--bg);overflow-x:hidden;transition:background .22s,color .22s}
:root[data-theme="dark"] body{background:radial-gradient(ellipse at 8% 0%,rgba(41,94,64,.18),transparent 35%),radial-gradient(ellipse at 94% 15%,rgba(104,77,35,.12),transparent 27%),var(--bg)}
button,input,textarea{font:inherit}button{cursor:pointer}button:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid color-mix(in srgb,var(--green) 35%,transparent);outline-offset:2px}
.wrap{width:min(1100px,calc(100% - 30px));margin:0 auto;padding:15px 0 38px}
.topbar{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:12px;margin:0 auto 14px;min-height:92px}
.brand-logo{grid-column:2;grid-row:1;display:block;width:94px;height:94px;object-fit:contain;filter:drop-shadow(0 5px 10px rgba(20,65,110,.10))}
.theme-toggle{grid-column:1;grid-row:1;justify-self:start;display:inline-flex;align-items:center;gap:8px;min-height:42px;padding:9px 13px;border:1px solid var(--line);border-radius:14px;background:var(--paper);color:var(--text);font-size:12px;font-weight:700;box-shadow:0 4px 12px rgba(0,0,0,.035);transition:.18s}
.theme-toggle:hover{border-color:var(--green);transform:translateY(-1px)}.theme-symbol{display:block;width:22px;height:22px;flex:0 0 22px;object-fit:contain;line-height:1;transition:filter .55s ease,transform .25s ease;transform-origin:center center}:root[data-theme="dark"] .theme-symbol{filter:invert(1)}
.dictionary-count{grid-column:3;grid-row:1;justify-self:end;padding:8px 12px;border:1px solid var(--green-border);border-radius:999px;background:var(--green-soft);color:var(--green-deep);font-size:11px;font-weight:700;white-space:nowrap}
.card{background:var(--paper);border:1px solid var(--line);border-radius:22px;box-shadow:var(--shadow);transition:background .2s,border-color .2s}
.translator{padding:clamp(16px,3vw,27px)}
.section-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:16px}.section-head h2,.panel h2,.history-head h2{font-size:16px;margin:0;font-weight:800}.section-subtitle{font-size:11px;color:var(--muted);margin-top:5px}
.language-bar{display:grid;grid-template-columns:minmax(0,1fr) 48px minmax(0,1fr);gap:10px;align-items:center;margin-bottom:17px}
.lang{padding:13px 15px;border:1px solid var(--line);border-radius:15px;background:var(--paper-soft);min-width:0}.lang small{display:block;font-size:10px;color:var(--muted);margin-bottom:6px}.lang strong{font-size:15px}
.swap{width:45px;height:45px;border-radius:15px;border:1px solid var(--green-border);background:var(--green-soft);color:var(--green-deep);font-size:23px;transition:transform .25s,background .2s}.swap:hover{transform:rotate(180deg)}
.input-label{display:flex;justify-content:space-between;gap:10px;margin:0 2px 9px;font-size:12px;color:var(--text);font-weight:700}.input-label span:last-child{font-size:10px;color:var(--muted);font-weight:400}
textarea{display:block;width:100%;min-height:126px;resize:vertical;border:1px solid var(--line-strong);border-radius:17px;padding:15px 16px;background:var(--field);color:var(--text);outline:none;font:16px/2 Tahoma,sans-serif;transition:border-color .2s,box-shadow .2s,background .2s}
textarea:focus,input:focus{border-color:var(--green);box-shadow:0 0 0 3px color-mix(in srgb,var(--green) 13%,transparent)}textarea::placeholder,input::placeholder{color:var(--muted);opacity:.78}
.actions{display:flex;flex-wrap:wrap;gap:9px;margin-top:12px}.btn{border:1px solid var(--line-strong);border-radius:12px;padding:11px 15px;color:var(--text);background:var(--paper);font-size:12px;transition:.18s}.btn:hover{border-color:var(--green);transform:translateY(-1px);background:var(--paper-soft)}
.btn.primary{border:0;background:linear-gradient(135deg,#21845c,#116646);color:#fff;font-weight:800;min-width:142px;box-shadow:0 7px 17px rgba(19,111,72,.16)}.btn.primary:hover{background:linear-gradient(135deg,#1c7954,#0d583b)}.btn.subtle{background:var(--paper-soft);color:var(--muted)}
.result{margin-top:19px;border:1px solid var(--result-line);border-radius:18px;padding:16px;background:linear-gradient(135deg,var(--result),var(--paper) 76%)}.result-head{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:9px}.result-head strong{font-size:12px;color:var(--green-deep)}
.mini{border:0;background:transparent;color:var(--green);font-size:11px;padding:5px}.mini:hover{text-decoration:underline}.mini:disabled{opacity:.4;cursor:not-allowed}
.result-text{min-height:42px;font-size:17px;line-height:2.1;overflow-wrap:anywhere;white-space:pre-wrap}.result-text.empty{font-size:12px;color:var(--muted)}
.result-foot{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:9px;color:var(--muted);font-size:10px}.result-categories{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}
.tag{display:inline-flex;align-items:center;gap:5px;padding:5px 9px;border:1px solid var(--green-border);border-radius:999px;background:var(--paper);color:var(--green-deep);font-size:10px}
.suggestions{margin-top:12px;padding:13px 14px;border:1px solid var(--gold-border);border-radius:15px;background:var(--gold-soft)}.suggestions[hidden]{display:none}.suggestions-title{font-size:11px;color:var(--gold);margin-bottom:9px;font-weight:700}.suggestion-list{display:flex;flex-wrap:wrap;gap:8px}.suggestion-chip{border:1px solid var(--gold-border);background:var(--paper);border-radius:999px;padding:8px 12px;color:var(--gold);font-size:11px}.suggestion-chip:hover{border-color:var(--gold);filter:brightness(.98)}
.panel{margin-top:17px;padding:clamp(16px,3vw,24px)}.panel h2{margin-bottom:13px}.search-wrap{position:relative;margin-bottom:13px}.search-wrap:before{content:"⌕";position:absolute;right:13px;top:50%;transform:translateY(-54%);color:var(--muted);font-size:22px;pointer-events:none}.search-wrap input,.history-search{width:100%;border:1px solid var(--line-strong);border-radius:13px;background:var(--field);color:var(--text);padding:12px 40px 12px 13px;font-size:12px;outline:none;min-width:0}
.category-list{display:flex;gap:7px;flex-wrap:wrap;margin:3px 0 13px}.category-chip{border:1px solid var(--line);border-radius:999px;background:var(--paper-soft);color:var(--text);padding:7px 11px;font-size:10px;white-space:nowrap;transition:.15s}.category-chip small{color:var(--muted);margin-right:4px}.category-chip.active{background:var(--green-soft);border-color:var(--green-border);color:var(--green-deep);font-weight:800}.category-chip:hover{border-color:var(--green)}
.word-meta{font-size:10px;color:var(--muted);margin:10px 2px}.word-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}.word-card{display:flex;flex-direction:column;align-items:stretch;gap:7px;text-align:right;border:1px solid var(--line);border-radius:14px;padding:12px;background:var(--paper-soft);color:var(--text);min-width:0;transition:transform .16s,border-color .16s,background .16s}.word-card:hover{transform:translateY(-2px);border-color:var(--green);background:var(--paper)}.fa-word{display:flex;align-items:center;justify-content:space-between;gap:7px;font-size:13px;font-weight:800}.kind-pill{font-size:9px;font-weight:400;color:var(--muted);border:1px solid var(--line);border-radius:999px;padding:3px 6px;white-space:nowrap}.lo-word{font-size:12px;line-height:1.8;color:var(--green-deep);overflow-wrap:anywhere}.word-meaning{font-size:10px;line-height:1.7;color:var(--muted)}.word-category{font-size:9px;color:var(--muted)}
.more-wrap{grid-column:1/-1;display:flex;justify-content:center;padding:9px}.more-button{border:1px solid var(--green-border);border-radius:12px;padding:10px 17px;background:var(--green-soft);color:var(--green-deep);font-size:11px;font-weight:700}
.empty-list,.empty-history{grid-column:1/-1;padding:18px;text-align:center;color:var(--muted);font-size:11px;border:1px dashed var(--line-strong);border-radius:13px}
.history{margin-top:17px;padding:clamp(16px,3vw,22px)}.history-head{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}.history-tools{display:flex;align-items:center;gap:8px;min-width:0}.history-search{width:min(230px,42vw);padding:9px 11px;font-size:10px}.history-item{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px 3px;border-bottom:1px solid var(--line)}.history-item:last-child{border-bottom:0}.history-item p{margin:0;line-height:1.8;font-size:11px;overflow-wrap:anywhere}.history-item .muted{font-size:9px;color:var(--muted)}.history-item button{flex:none;border:1px solid var(--line);border-radius:9px;padding:7px 10px;background:var(--paper-soft);color:var(--green-deep);font-size:10px}
@media(max-width:760px){.word-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.wrap{width:min(100% - 22px,650px)}.dictionary-count{font-size:9px;padding:7px 9px}.brand-logo{width:84px;height:84px}}
@media(max-width:480px){.topbar{min-height:78px;gap:6px}.brand-logo{width:76px;height:76px}.theme-toggle{min-height:38px;padding:7px 9px;font-size:10px;gap:5px}.dictionary-count{font-size:9px;padding:6px 7px}.language-bar{gap:7px;grid-template-columns:minmax(0,1fr) 39px minmax(0,1fr)}.lang{padding:11px 10px}.lang strong{font-size:13px}.swap{width:37px;height:37px;border-radius:12px;font-size:20px}.actions .btn{flex:1}.actions .primary{flex-basis:100%}.word-grid{grid-template-columns:1fr}.history-tools{flex:1;justify-content:flex-end}.history-search{max-width:150px}.result-text{font-size:15px}.section-head h2,.panel h2,.history-head h2{font-size:14px}}
/* انتقال تم شبیه نمونه: صفحهٔ تازه به‌صورت دایره‌ای از محل آیکون آشکار می‌شود. */
:root{view-transition-name:root}
::view-transition-group(root){animation-duration:3200ms;animation-timing-function:cubic-bezier(.2,.76,.18,1)}
::view-transition-old(root){animation:none;z-index:1}
::view-transition-new(root){animation:lorvazheCircularReveal 3200ms cubic-bezier(.2,.76,.18,1) both;z-index:2}
@keyframes lorvazheCircularReveal{
  from{clip-path:circle(0 at var(--theme-origin-x,92%) var(--theme-origin-y,8%));}
  to{clip-path:circle(180vmax at var(--theme-origin-x,92%) var(--theme-origin-y,8%));}
}
/* مرورگرهای بدون View Transitions از این پوشش دایره‌ای جایگزین استفاده می‌کنند. */
:root.theme-fallback::before{content:"";position:fixed;inset:0;z-index:9998;pointer-events:none;clip-path:circle(0 at var(--theme-origin-x,92%) var(--theme-origin-y,8%));animation:lorvazheFallbackReveal 3200ms cubic-bezier(.2,.76,.18,1) both}
:root[data-theme="dark"].theme-fallback::before{background:radial-gradient(circle at 82% 12%,rgba(255,255,255,.12),transparent 24%),#101915}
:root[data-theme="light"].theme-fallback::before{background:radial-gradient(circle at 82% 12%,rgba(255,224,151,.18),transparent 24%),#f4f8f5}
@keyframes lorvazheFallbackReveal{to{clip-path:circle(180vmax at var(--theme-origin-x,92%) var(--theme-origin-y,8%));}}
.theme-toggle.theme-changing .theme-symbol{animation:themeIconJourney 3200ms cubic-bezier(.22,.8,.22,1);will-change:transform,filter}
@keyframes themeIconJourney{0%{transform:rotate(0) scale(1)}38%{transform:rotate(150deg) scale(1.55)}72%{transform:rotate(315deg) scale(.88)}100%{transform:rotate(360deg) scale(1)}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;transition:none!important;animation:none!important}::view-transition-group(root){animation-duration:1ms!important}::view-transition-new(root){animation-duration:1ms!important}}
</style>
</head>
<body>
<main class="wrap">
  <header class="topbar" aria-label="لُرواژه">
    <button class="theme-toggle" id="themeToggle" type="button" aria-label="فعال کردن حالت شب" aria-pressed="false"><img class="theme-symbol" id="themeSymbol" src="data:image/png;base64," alt="آیکون ماه" width="22" height="22"><span id="themeLabel">حالت شب</span></button>
    <img class="brand-logo" src="data:image/png;base64," alt="نشان اصلی لُرواژه؛ لری و فارسی">
    <span class="dictionary-count" id="dictionaryCount">واژه‌نامه</span>
  </header>

  <section class="card translator" aria-label="مترجم لُرواژه">
    <div class="section-head"><div><h2>ترجمه</h2><div class="section-subtitle">فارسی و زبان لری رایج در رومشکان</div></div></div>
    <div class="language-bar">
      <div class="lang"><small>زبان مبدأ</small><strong id="sourceLang">فارسی</strong></div>
      <button class="swap" id="swapBtn" title="جابه‌جایی جهت ترجمه" aria-label="جابه‌جایی جهت ترجمه">⇄</button>
      <div class="lang"><small>زبان مقصد</small><strong id="targetLang">لری</strong></div>
    </div>
    <label class="input-label" for="sourceText"><span id="inputLabel">متن فارسی</span><span id="charCount">۰ نویسه</span></label>
    <textarea id="sourceText" placeholder="واژه یا عبارت را بنویسید…" spellcheck="false" autocomplete="off" autocapitalize="off"></textarea>
    <div class="actions"><button class="btn primary" id="translateBtn" type="button">ترجمه</button><button class="btn" id="clearBtn" type="button">پاک کردن</button></div>
    <div class="result" aria-live="polite" aria-atomic="true">
      <div class="result-head"><strong>نتیجهٔ ترجمه</strong><button class="mini" id="copyBtn" type="button" disabled>کپی نتیجه ⧉</button></div>
      <div class="result-text empty" id="resultText">ترجمهٔ شما اینجا نمایش داده می‌شود.</div>
      <div class="result-categories" id="resultCategories"></div>
      <div class="result-foot"><span id="resultStatus">آمادهٔ ترجمه</span><span id="matchCount">—</span></div>
    </div>
    <div class="suggestions" id="suggestions" hidden><div class="suggestions-title">واژه‌های نزدیک؛ برای جایگزینی انتخاب کن:</div><div class="suggestion-list" id="suggestionList"></div></div>
  </section>

  <section class="card panel" aria-label="دسته‌بندی و جست‌وجوی واژه‌ها">
    <h2>واژه‌نامه</h2>
    <div class="search-wrap"><input id="dictionarySearch" type="search" placeholder="جست‌وجوی هوشمند فارسی یا لری؛ با اعراب یا بدون اعراب…" autocomplete="off" aria-label="جست‌وجوی هوشمند در واژه‌نامه" title="واژه را کامل، بخشی از آن یا بدون اعراب وارد کن؛ غلط‌های تایپی نزدیک هم پیشنهاد می‌شوند."></div>
    <div class="search-hint" style="margin:7px 2px 0;color:var(--muted);font-size:11px;line-height:1.8">🔎 جست‌وجو در هر دو زبان؛ بدون نیاز به اعراب، با پشتیبانی از بخشی از واژه و غلط‌های تایپی نزدیک.</div>
    <div class="category-list" id="categoryList" aria-label="دسته‌بندی واژه‌ها"></div>
    <div class="word-meta" id="wordMeta">در حال آماده‌سازی واژه‌نامه…</div>
    <div class="word-grid" id="wordGrid"><div class="empty-list">واژه‌ها اینجا نمایش داده می‌شوند.</div></div>
  </section>

  <section class="card history" aria-label="سابقهٔ ترجمه">
    <div class="history-head"><h2>سابقهٔ ترجمه</h2><div class="history-tools"><input class="history-search" id="historySearch" type="search" placeholder="جست‌وجو در سابقه…" aria-label="جست‌وجو در سابقه"><button class="mini" id="clearHistoryBtn" type="button">پاک کردن سابقه</button></div></div>
    <div class="history-list" id="historyList"><div class="empty-history">هنوز ترجمه‌ای ثبت نشده است.</div></div>
  </section>
