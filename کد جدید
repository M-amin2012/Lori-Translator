}

function damerauLevenshtein(a,b) {
  const m=a.length,n=b.length;if(!m)return n;if(!n)return m;
  const dp=Array.from({length:m+1},()=>Array(n+1).fill(0));
  for(let i=0;i<=m;i++)dp[i][0]=i;for(let j=0;j<=n;j++)dp[0][j]=j;
  for(let i=1;i<=m;i++)for(let j=1;j<=n;j++) {
    const cost=a[i-1]===b[j-1]?0:1;
    dp[i][j]=Math.min(dp[i-1][j]+1,dp[i][j-1]+1,dp[i-1][j-1]+cost);
    if(i>1&&j>1&&a[i-1]===b[j-2]&&a[i-2]===b[j-1])dp[i][j]=Math.min(dp[i][j],dp[i-2][j-2]+1);
  }
  return dp[m][n];
}
function suggestionCandidates(query) {
  const q=normalize(query);if(q.length<3)return[];
  const qParts=q.split(' '),rows=sourceIndex().filter(x=>x.parts.length===qParts.length);
  const seen=new Set(),ranked=[];
  for(const row of rows) {
    const key=normalize(row.from);if(!key||key===q||seen.has(key))continue;seen.add(key);
    const maxDiff=Math.max(2,Math.ceil(q.length*.34));
    if(Math.abs(key.length-q.length)>maxDiff)continue;
    const dist=damerauLevenshtein(q,key);
    const allowed=q.length<=4?1:q.length<=8?2:Math.max(2,Math.ceil(q.length*.27));
    if(dist>allowed)continue;
    let score=1-dist/Math.max(q.length,key.length);
    if(key.startsWith(q)||q.startsWith(key))score+=.035;
    if(score>=.72) {
      const resolved=resolveOutput(row,row.from);
      ranked.push({label:row.from,score,output:resolved.text});
    }
  }
  return ranked.sort((a,b)=>b.score-a.score||a.label.length-b.label.length).slice(0,4);
}
function collectSuggestions(result,input) {
  const queries=[];
  if(result.matched===0&&input.trim())queries.push(input.trim());
  for(const word of result.unknown)if(word.trim()&&normalize(word).length>=3)queries.push(word.trim());
  const seen=new Set(),items=[];
  for(const query of queries)for(const candidate of suggestionCandidates(query)) {
    const key=normalize(candidate.label);if(seen.has(key))continue;seen.add(key);items.push(candidate);if(items.length>=6)return items;
  }
  return items;
}
function renderSuggestions(items) {
